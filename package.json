{
  "name": "cl.jotacalderon.cf.archivosprivados",
  "description": "sistema de archivos privados",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node app",
    "dev": "npx nodemon --legacy-watch app  --ignore frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "prepare": "husky || true",
    "check-npm": "npm outdated"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "jest": {
    "testMatch": [
      "**/backend__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "archiver": "8.0.0",
    "cl.jotacalderon.cf.framework": "1.17.0",
    "express-fileupload": "1.6.0",
    "markdown-it": "15.0.3",
    "unzipper": "0.12.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "prettier": "3.10.1"
  }
}
